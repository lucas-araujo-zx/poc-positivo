# Token que os testadores digitam na tela de acesso. Fica só no servidor.
POSITIVO_LOGIN_TOKEN=

# IDs dos agentes de widget, separados por |. O nome é lido na ElevenLabs.
# Exemplo: agent_abc123|agent_def456
# O consultor da loja não entra aqui: ele é fixo e abre o site.
POSITIVO_AGENTS=

# Chave da ElevenLabs, só no servidor. Usada para o nome dos agentes, a URL assinada e o resultado da chamada.
ELEVENLABS_API_KEY=
